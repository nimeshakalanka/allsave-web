# Comma-separated list of frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:3000
# Max video length in seconds and max output size in MB
MAX_DURATION=1800
MAX_FILESIZE_MB=500
MAX_CONCURRENT_JOBS=3
MAX_QUEUED_JOBS=20
# Per-IP limits (slowapi syntax)
RATE_LIMIT_INFO=20/minute
RATE_LIMIT_JOBS=10/minute
# Optional: Netscape-format cookies file (mounted into the container) and proxy for YouTube/Instagram blocks
YTDLP_COOKIES_FILE=
PROXY_URL=
# Reverse proxy IP(s) whose X-Forwarded-For header is trusted for rate limiting
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Telegram bot (optional; runs inside this backend when BOT_TOKEN is set) ---
# API_ID/API_HASH from https://my.telegram.org, BOT_TOKEN from @BotFather
BOT_TOKEN=
API_ID=
API_HASH=
# mongodb://mongo:27017 is the bundled container in docker-compose; use your Atlas URI to keep the old bot's data
MONGO_URI=mongodb://mongo:27017
# Comma-separated admin user IDs for /sub, /stats, /bcast
SUDO=
# Force-subscribe channel id for /start (0 disables) and its invite link
CHID=0
CHANNEL_LINK=https://t.me/szteambots
BOT_USERNAME=AIl_Save_Bot
DEV_LINK=https://t.me/akalankanime2
FREE_DAILY_LIMIT=4
COOLDOWN_MINUTES=30
PREMIUM_DAYS=30
